{
  "name": "card-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build",
    "dev": "wrangler dev",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "build": "esbuild src/client-local.ts --bundle --format=esm --outfile=public/local.js --banner:js=\"// GENERATED by 'npm run build' from src/client-local.ts — do not edit by hand.\"",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test:rummy": "node src/rummy.smoke.ts",
    "test:hearts": "node src/hearts.smoke.ts",
    "test:pj": "node src/pj.smoke.ts"
  },
  "dependencies": {
    "partyserver": "^0.5.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260531.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.95.0"
  }
}

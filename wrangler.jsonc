{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cardgames",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/parties/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HighLowJack", "class_name": "HighLowJackServer" },
      { "name": "Rummy500", "class_name": "Rummy500Server" },
      { "name": "Hearts", "class_name": "HeartsServer" },
      { "name": "PegsAndJokers", "class_name": "PegsAndJokersServer" }
    ]
  },
  // Migrations are append-only and must match what production has already
  // applied. v1/v2 were the only ones ever deployed (Hearts existed in code on
  // `main` but had no binding/migration, so it never shipped). v3/v4 add the
  // two new Durable Object classes cleanly.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HighLowJackServer"] },
    { "tag": "v2", "new_sqlite_classes": ["Rummy500Server"] },
    { "tag": "v3", "new_sqlite_classes": ["HeartsServer"] },
    { "tag": "v4", "new_sqlite_classes": ["PegsAndJokersServer"] }
  ]
}

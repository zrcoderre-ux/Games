{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"],
  // Node-only scripts (smoke tests, battle harnesses, bidding analyses) use
  // `process` and are run with `node`, never bundled into the Worker, so keep
  // them out of the Worker type-check. Tests live in test/, outside `include`.
  "exclude": [
    "node_modules",
    "src/*.smoke.ts",
    "src/*.battle.ts",
    "src/*.test.ts",
    "src/bid-threshold.ts",
    "src/bid23.ts",
    "src/hand-eval.ts",
    "src/six-threshold.ts"
  ]
}

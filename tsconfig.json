{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"],
  // rummy.smoke.ts is a Node script (uses `process`); it's run via `node`, not
  // bundled into the Worker, so keep it out of the Worker type-check.
  "exclude": ["node_modules", "src/rummy.smoke.ts", "src/hearts.smoke.ts", "src/pj.smoke.ts"]
}

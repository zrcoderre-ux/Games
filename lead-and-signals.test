import { test } from "node:test";
import assert from "node:assert/strict";
import {
  createGame,
  applyMove,
  legalMoves,
  type GameState,
  type Move,
  type Card,
  type Suit,
} from "../src/engine.ts";
import { aiMove } from "../src/ai.ts";

function resolveBidding(seed: number): GameState {
  // Seat 1 opens, takes the bid at 2, everyone else passes -> seat 1 is bidder.
  let g = createGame(4, seed);
  g = applyMove(g, { type: "bid", seat: 1, amount: 2 });
  g = applyMove(g, { type: "pass", seat: 2 });
  g = applyMove(g, { type: "pass", seat: 3 });
  g = applyMove(g, { type: "pass", seat: 0 });
  return g;
}

// ---------- trump on the opening lead ----------

test("after bidding, play begins with trump undeclared and the bidder to lead", () => {
  const g = resolveBidding(2);
  assert.equal(g.phase, "playing");
  assert.equal(g.trump, null);
  assert.equal(g.turn, 1);
  assert.equal(g.leaderSeat, 1);
});

test("the bidder's opening options are: declare a trump, or lead a card (no joker)", () => {
  const g = resolveBidding(2);
  const moves = legalMoves(g);
  // All four trump declarations are offered.
  for (const suit of ["C", "D", "H", "S"] as Suit[]) {
    assert.ok(moves.some((m) => m.type === "selectTrump" && m.suit === suit));
  }
  // Lead options exist and never include the joker.
  const leads = moves.filter((m): m is Extract<Move, { type: "play" }> => m.type === "play");
  assert.ok(leads.length > 0);
  assert.ok(leads.every((m) => !("joker" in m.card)));
});

test("leading without declaring sets trump to the led card's suit", () => {
  const g = resolveBidding(2);
  const lead = legalMoves(g).find((m): m is Extract<Move, { type: "play" }> => m.type === "play")!;
  const led = lead.card as { rank: number; suit: Suit };
  const after = applyMove(g, lead);
  assert.equal(after.trump, led.suit); // the led suit became trump
  assert.equal(after.currentTrick.length, 1);
  assert.equal(after.currentTrick[0].card && (after.currentTrick[0].card as any).suit, led.suit);
});

test("declaring a trump first lets the bidder then lead an off-trump card", () => {
  let g = resolveBidding(2);
  const bidderHand = g.hands[1];
  // Pick a suit the bidder holds, declare a DIFFERENT suit as trump if possible.
  const suitsHeld = new Set(bidderHand.filter((c) => !("joker" in c)).map((c) => (c as any).suit));
  const allSuits: Suit[] = ["C", "D", "H", "S"];
  const trumpSuit = allSuits.find((s) => suitsHeld.has(s))!;
  g = applyMove(g, { type: "selectTrump", seat: 1, suit: trumpSuit });
  assert.equal(g.phase, "playing");
  assert.equal(g.trump, trumpSuit);
  // Now the bidder may lead any non-joker card, including off-trump ones.
  const leads = legalMoves(g).filter((m): m is Extract<Move, { type: "play" }> => m.type === "play");
  assert.ok(leads.length > 0);
  // selectTrump is no longer offered once trump is set.
  assert.ok(!legalMoves(g).some((m) => m.type === "selectTrump"));
});

test("the AI bidder declares its strongest suit as trump on its opening turn", () => {
  // Find a seed where seat 1 (a bot here) wins the bid, then check it declares.
  const g = resolveBidding(7);
  assert.equal(g.trump, null);
  const m = aiMove(g, 1);
  assert.equal(m.type, "selectTrump");
});

// ---------- signal-responsive, non-mechanical bidding ----------

// Build a bidding position: dealer 0, seats 1 & 2 have acted, seat 3 (our AI)
// is to act. An opponent (seat 2) holds the high bid of 2 with a chosen signal.
// Seat 3 gets a medium-ish hand whose safe estimate falls just one short of the
// bid needed to raise — exactly the "marginal" zone where signals decide.
function marginalPosition(opts: { highSeat: number; highAmt: number; theirSignal: "weak" | "medium" | "strong" }): GameState {
  const g = createGame(4, 1);
  // Seat 3's hand: a solid five-trump spade holding whose safe estimate lands
  // one short of the raise to 3 -> exactly the "marginal" zone signals decide.
  const hand: Card[] = [
    { rank: 14, suit: "S" },
    { rank: 13, suit: "S" },
    { rank: 12, suit: "S" },
    { rank: 10, suit: "S" },
    { rank: 9, suit: "S" },
    { rank: 7, suit: "C" },
  ];
  const signals: (("weak" | "medium" | "strong") | null)[] = [null, null, null, null];
  signals[opts.highSeat] = opts.theirSignal;
  return {
    ...g,
    phase: "bidding",
    bidTurn: 3,
    bidsActed: 2,
    highBid: { seat: opts.highSeat, amount: opts.highAmt },
    signals,
    hands: g.hands.map((h, s) => (s === 3 ? hand : h)),
  };
}

test("a marginal hand sometimes contests and sometimes folds (non-mechanical)", () => {
  // Opponent (seat 2) holds the bid and signalled weak; seat 3 reads itself as
  // at least equal. With a low rng roll it contests; with a high roll it folds.
  const s = marginalPosition({ highSeat: 2, highAmt: 2, theirSignal: "weak" });

  const contest = aiMove(s, 3, () => 0.0);
  assert.equal(contest.type, "bid");
  if (contest.type === "bid") assert.equal(contest.amount, 3); // raised to take it

  const fold = aiMove(s, 3, () => 0.99);
  assert.equal(fold.type, "pass");
});

test("a marginal hand will not chase a confidently strong opponent", () => {
  // Opponent signalled strong and outclasses us: we never gamble, even on a 0 roll.
  const s = marginalPosition({ highSeat: 2, highAmt: 2, theirSignal: "strong" });
  const m = aiMove(s, 3, () => 0.0);
  assert.equal(m.type, "pass");
});

test("the AI does not raise over its own partner on a marginal hand", () => {
  // Seat 1 is seat 3's partner (same parity). Even with a weak partner signal and
  // a 0 roll, a non-strong hand should not step on the partner's bid.
  const s = marginalPosition({ highSeat: 1, highAmt: 2, theirSignal: "weak" });
  const m = aiMove(s, 3, () => 0.0);
  assert.equal(m.type, "pass");
});

test("signal-aware bidding still produces terminating, legal all-AI games", () => {
  for (let seed = 1; seed <= 25; seed++) {
    let g = createGame(4, seed * 333 + 1);
    let guard = 0;
    while (g.phase !== "gameOver") {
      const seat = g.phase === "bidding" ? g.bidTurn : g.turn;
      const m = aiMove(g, seat);
      assert.ok(legalMoves(g).some((l) => JSON.stringify(l) === JSON.stringify(m)));
      g = applyMove(g, m);
      if (++guard > 200000) throw new Error("did not terminate");
    }
    assert.ok(g.winner === 0 || g.winner === 1);
  }
});
